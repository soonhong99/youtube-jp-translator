# =================================
# Gemini AI 모델 설정
# =================================

# Gemini API Key (필수)
GEMINI_API_KEY="본인의 api키 입력"

# 사용할 Gemini 모델 (선택, 기본값: gemini-1.5-pro-latest)
# 가능한 모델:
# - gemini-2.0-flash-exp (최신 실험 모델, 최고 성능)
# - gemini-1.5-pro-latest (프로덕션 권장, 높은 품질)
# - gemini-1.5-flash-latest (빠른 응답)
# - gemini-pro (기본 모델, fallback)
GEMINI_MODEL=gemini-1.5-pro-latest

# 번역 창의성 조절 (선택, 기본값: 0.3)
# 0.0 = 매우 일관된 번역, 1.0 = 매우 창의적인 번역
# 번역 작업에는 0.1-0.5 범위를 권장
GEMINI_TEMPERATURE=0.3
