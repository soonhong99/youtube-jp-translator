# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
STT_REQUEST_TOPIC="stt_requests"
STT_RESULT_TOPIC="stt_results"

# New Kafka Topics for Translation Workflow
KAFKA_TRANSLATION_REQUESTS_TOPIC="translation_requests"
