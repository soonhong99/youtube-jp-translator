# AI Orchestrator 최적화된 환경 설정

# Gemini API 설정
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash-latest"  # 비용 효율적인 Flash 모델 사용
GEMINI_TEMPERATURE="0.3"

# 할당량 최적화 설정
MAX_CONCURRENT_TASKS=3                    # 동시 처리 작업 수 제한
QUOTA_MANAGEMENT_ENABLED=true             # 할당량 관리 활성화
AI_SEGMENTATION_ENABLED=false             # AI 문장 분할 비활성화 (비용 절약)
CIRCUIT_BREAKER_ENABLED=true              # Circuit Breaker 보호 활성화

# 캐시 설정
TRANSLATION_CACHE_TTL=3600                # 번역 결과 캐시 시간 (1시간)

# 로깅 설정
LOG_LEVEL=INFO

# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_AI_CACHE=4

# LangChain 추적 (선택사항)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your_langchain_api_key

# 할당량 제한 설정 (필요시 조정)
DAILY_QUOTA_LIMIT=40                      # 일일 API 호출 제한
DAILY_COST_LIMIT=1.0                      # 일일 비용 제한 (USD)
HOURLY_QUOTA_LIMIT=15                     # 시간당 API 호출 제한